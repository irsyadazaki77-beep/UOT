# Local environment and secrets
.env
.env.*
!.env.example

# Dependencies and generated output
node_modules/
dist/
coverage/

# Runtime Database & Persistence Files
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/runtime/
